# ─────────────────────────────────────────────
# Environment Variables Template
# Copie para .env e ajuste os valores
# ─────────────────────────────────────────────

# ───── App ─────
APP_NAME=OpenRouter Data Engine
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ───── Database ─────
DATABASE_URL=postgresql://dataeng:dataeng@localhost:5432/dataeng
WAREHOUSE_URL=postgresql://dataeng:dataeng@localhost:5432/warehouse

# ───── Cloud Storage (S3) ─────
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1
S3_BUCKET=openrouter-data-lake

# ───── API Keys ─────
OPENAI_API_KEY=

# ───── Airflow ─────
AIRFLOW_FERNET_KEY=

# ───── Data Quality ─────
QUALITY_FAIL_ON_ERROR=false